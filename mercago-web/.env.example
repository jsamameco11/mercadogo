NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=https://ecommerce-reb.miacademiapreu.com

# Google Identity Services — mismo patrón que el resto del ecosistema
# (casa-de-la-palabra-web, ingenieria, contrataciones). Requiere un OAuth
# Client ID (tipo "Aplicación web") en Google Cloud Console con
# NEXT_PUBLIC_SITE_URL registrado como "Authorized JavaScript origin".
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Wasabi (S3-compatible) — fotos de anuncios, subidas por cualquier usuario
# autenticado. Server-only, nunca con prefijo NEXT_PUBLIC_.
WASABI_ACCESS_KEY=
WASABI_SECRET_KEY=
WASABI_REGION=us-central-1
WASABI_ENDPOINT=https://s3.us-central-1.wasabisys.com
WASABI_BUCKET=ecommers-reb
# Esta cuenta de Wasabi bloquea lectura pública de objetos — las imágenes se
# sirven a través de /m/... en esta misma app (ver src/lib/wasabi.ts).
MEDIA_PUBLIC_BASE_URL=https://ecommerce-reb.miacademiapreu.com/m
